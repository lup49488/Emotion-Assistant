# Copy this file to .env and set the provider key and session secret.
LLM_PROVIDER=deepseek
LLM_API_MODEL=deepseek-chat
LLM_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Generate at least 32 random characters. This must stay stable across restarts.
API_SESSION_SECRET=

# Docker exposes the Nginx service at http://localhost:8080 by default.
API_COOKIE_SECURE=false
API_PUBLIC_MODE=false
API_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
STORAGE_BACKEND=sqlite
SQLITE_DATABASE_PATH=/app/data/chatbot.db
