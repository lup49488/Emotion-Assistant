# Copy this file to .env and set the provider key and session secret.
LLM_PROVIDER=deepseek
LLM_API_MODEL=deepseek-chat
LLM_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_MAX_NEW_TOKENS=1024

# Generate at least 32 random characters. This must stay stable across restarts.
API_SESSION_SECRET=

# ── Local defaults ───────────────────────────────────────────────────────────
# Docker exposes the Nginx service at http://localhost:8080 by default.
API_COOKIE_SECURE=false
API_PUBLIC_MODE=false
API_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
STORAGE_BACKEND=sqlite
SQLITE_DATABASE_PATH=/app/data/chatbot.db

# Match the Linux owner of the bind-mounted project directories. On a VPS,
# set these to the account that runs docker compose, for example:
#   APP_UID=$(id -u deploy)
#   APP_GID=$(id -g deploy)
APP_UID=1000
APP_GID=1000

# The API is only reachable through Nginx, which overwrites the address headers,
# so the forwarded client address can be trusted. Turning this off makes every
# caller share the Nginx container IP and breaks per-IP login rate limiting.
API_TRUST_PROXY_HEADERS=true
# The interactive OpenAPI page is proxied at /docs when enabled. Keep it off in
# any deployment that is reachable from outside the host.
API_ENABLE_DOCS=false

# ── Before going public (HTTPS / Cloudflare Tunnel) ──────────────────────────
# Change these three, otherwise session cookies are sent without the Secure flag
# and the trusted-host check still only accepts localhost:
#   API_COOKIE_SECURE=true
#   API_PUBLIC_MODE=true
#   API_TRUSTED_HOSTS=your-domain.example
