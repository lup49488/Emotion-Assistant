# Core model selection
# Copy this file to .env for local use. Keep real API keys out of .env.example.
# Optional: .env.local can override .env on this machine and should not be committed.
LLM_PROVIDER=openai_compatible
CHAT_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# Multilingual emotion classifier. It analyzes the original text directly.
EMOTION_MODEL_NAME=tabularisai/multilingual-emotion-classification
# Below this score Serenova keeps the emotion result as uncertain.
EMOTION_CONFIDENCE_THRESHOLD=0.60
# Set false only when replacing the model with a single-label classifier.
EMOTION_MODEL_MULTI_LABEL=true
# Refine a fear reading into anxiety when the text shows anticipatory worry.
EMOTION_ANXIETY_REFINEMENT=true

# Optional multilingual NLI supplement for safety assessment. The rule-based
# safety layer remains active when this is false or when the model is unavailable.
# The model has an additional CPU/RAM footprint; enable it deliberately.
SAFETY_SEMANTIC_ENABLED=true
SAFETY_SEMANTIC_PRELOAD=true
SAFETY_SEMANTIC_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
SAFETY_SEMANTIC_THRESHOLD=0.78

# OpenAI-compatible API providers
# Do not commit real API keys.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_MODEL=deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional provider failover chain. Only retryable API failures before the
# first streamed token can switch to a fallback. Keep keys in the provider
# variables above, never in this JSON value. Restart the API after changing it.
# Example: [{"provider":"openai","model":"gpt-4.1-mini"}]
LLM_FALLBACKS_JSON=

# Generation defaults
LLM_TEMPERATURE=0.8
LLM_TOP_P=0.9
# Default maximum output tokens when a client does not explicitly set max_new_tokens.
LLM_MAX_NEW_TOKENS=300

# API reliability and local cost guardrails. 0 disables a limit.
# Costs are estimates only; set the rates from the pricing for the exact model you use.
API_REQUEST_TIMEOUT_SECONDS=60
API_MAX_RETRIES=2
API_RETRY_BACKOFF_SECONDS=1
API_MAX_REQUESTS_PER_MINUTE=0
API_DAILY_BUDGET_USD=0
API_MONTHLY_BUDGET_USD=0
API_INPUT_COST_PER_1M_TOKENS=0
API_OUTPUT_COST_PER_1M_TOKENS=0

# Long-term memory candidates inferred from a conversation wait for the user
# to confirm them in Personal data. Explicit profile and preference statements
# are still written directly.
MEMORY_CONFIRM_LONG_TERM=true
MEMORY_PENDING_LIMIT=30

# RAG release gate. Prepare knowledge_base/rag_evaluation_cases.json first,
# then enable to publish only indexes that meet these quality thresholds.
RAG_RELEASE_GATE_ENABLED=false
RAG_RELEASE_MIN_CASES=5
RAG_RELEASE_MIN_PASS_RATE=80
RAG_RELEASE_MIN_SOURCE_RECALL=80
RAG_RELEASE_MIN_KEYWORD_COVERAGE=80
# Evaluated only when the corpus includes expected_outcome=insufficient cases.
RAG_RELEASE_MIN_INSUFFICIENT_REFUSAL=80

# Retain privacy-minimized HTTP observability events for this many days.
OBSERVABILITY_RETENTION_DAYS=90

# Public deployment hardening. Enable only behind HTTPS/Tunnel, then set the
# exact public host. Docs stay useful locally but should be disabled publicly.
API_PUBLIC_MODE=false
API_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],testserver
API_ENABLE_DOCS=true
API_MAX_REQUEST_BYTES=22020096
API_AUTH_MAX_ATTEMPTS=8
API_AUTH_WINDOW_SECONDS=900
# Set true only when requests reach FastAPI exclusively through your trusted proxy/Tunnel.
API_TRUST_PROXY_HEADERS=false

# Comma-separated user IDs permitted to open the operations dashboard.
API_OPERATIONS_USER_IDS=
# Comma-separated user IDs permitted to upload, delete, rebuild, and evaluate
# the shared RAG knowledge base. Empty falls back to API_OPERATIONS_USER_IDS.
API_RAG_ADMIN_USER_IDS=
# Optional manual live dialogue checks. Use a dedicated test account only.
DIALOGUE_REGRESSION_URL=
DIALOGUE_REGRESSION_USER_ID=
DIALOGUE_REGRESSION_ACCESS_KEY=
DIALOGUE_REGRESSION_PROVIDER=
DIALOGUE_REGRESSION_MODEL=
OPS_ALERT_MIN_REQUESTS=10
OPS_ALERT_HTTP_FAILURE_RATE=10
OPS_ALERT_AVERAGE_LATENCY_MS=5000
OPS_ALERT_PROVIDER_FAILURES=3
OPS_ALERT_JOB_FAILURES=1

# FastAPI signed-cookie session. Set API_SESSION_SECRET to a unique random value
# of at least 32 characters in .env.local or the server environment.
API_SESSION_SECRET=
API_SESSION_TTL_SECONDS=43200
API_SESSION_COOKIE_NAME=chatbot_session
API_CSRF_COOKIE_NAME=chatbot_csrf
# Set true when the API is served through HTTPS (for example via Cloudflare Tunnel).
API_COOKIE_SECURE=false
API_COOKIE_SAMESITE=lax
# Comma-separated browser frontend origins. Do not use * with Cookie authentication.
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Warm GoEmotions and the embedding model in a background thread when FastAPI starts.
# This never loads the local chat model.
API_PRELOAD_MODELS=true

# Local Hugging Face model performance
# LOCAL_MODEL_DTYPE supports auto, float16, bfloat16, float32.
LOCAL_MODEL_DTYPE=auto
# Example: flash_attention_2 or sdpa, if your installed torch/transformers supports it.
LOCAL_MODEL_ATTN_IMPLEMENTATION=
LOCAL_MODEL_LOW_CPU_MEM_USAGE=true
LOCAL_MODEL_COMPILE=false
# 0 means keep PyTorch default.
LOCAL_MODEL_CPU_THREADS=0
# Reject a likely out-of-memory load before Python exits unexpectedly.
LOCAL_MODEL_MEMORY_CHECK=true
LOCAL_MODEL_MEMORY_SAFETY_FACTOR=1.25
# Set only when the model name does not include its parameter count.
LOCAL_MODEL_PARAMETER_COUNT_B=0
# CPU/RAM offload is slower, but prevents a low-VRAM GPU from loading everything at once.
LOCAL_MODEL_ALLOW_CPU_OFFLOAD=false
LOCAL_MODEL_GPU_MAX_MEMORY_GB=5.5
LOCAL_MODEL_CPU_MAX_MEMORY_GB=12

# Gradio
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
GUI_PRELOAD_MODELS=true
# Keep Qwen on demand even when basic background warmup is enabled.
GUI_PRELOAD_LOCAL_LLM=false

# Storage backend. Keep json until you have run migrate_storage.py, then switch to sqlite.
STORAGE_BACKEND=json
# Optional absolute or relative SQLite database path. Empty uses data/chatbot.db.
SQLITE_DATABASE_PATH=

# Optional emergency password recovery. Leave blank in Git and set a unique random
# value of at least 20 characters only in the server environment or .env.local.
CHATBOT_ADMIN_RECOVERY_KEY=

# Knowledge base / RAG
KNOWLEDGE_ENABLED=false
KNOWLEDGE_TOP_K=4
KNOWLEDGE_RETRIEVAL_THRESHOLD=0.35
# hybrid_rrf re-ranks the vector candidate pool with BM25 lexical ranks via RRF.
# The vector score stays the evidence gate, so this improves ordering rather than
# recall. Use vector temporarily to compare a new corpus against the baseline.
# An unsupported value falls back to the default with a warning.
KNOWLEDGE_RETRIEVAL_MODE=hybrid_rrf
KNOWLEDGE_RRF_K=60
# Separate admission bar for lexical-only matches, so an exact rare term the
# embedding missed can still be retrieved. 0 disables it (vector score alone
# decides). BM25 scores are unbounded and corpus-dependent, so read the
# bm25_score column in the retrieval diagnostics panel before choosing a value;
# too low a bar admits common-word noise.
KNOWLEDGE_BM25_MIN_SCORE=0
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=120
# Search a wider candidate pool before relevance and diversity filtering.
KNOWLEDGE_CANDIDATE_MULTIPLIER=4
# Prefer source diversity, then backfill when too few results remain.
KNOWLEDGE_MAX_PER_SOURCE=2
# Hard budget for knowledge text injected into one prompt.
KNOWLEDGE_MAX_CONTEXT_CHARS=4000
# Used by the quality report to flag fragments that are too short.
KNOWLEDGE_MIN_CHUNK_CHARS=40
# When Knowledge retrieval is enabled for a request, return a structured
# insufficient-evidence result instead of asking the model to answer without sources.
RAG_REQUIRE_EVIDENCE=true
# Refuse near-domain *requests* this corpus cannot substantiate: live data, a
# medication dose, exact plot details, production-ready code, an investment
# recommendation. Rules match a request shape, never a bare subject word, so
# mentioning a diagnosis or a stock loss while describing how you feel is not
# blocked. Set false only while investigating a false positive.
RAG_NEAR_DOMAIN_GUARD_ENABLED=true

# Style reference / Style RAG
STYLE_ENABLED=true
STYLE_TOP_K=3
# Widen the candidate pool when filtering style documents by filename prefix.
STYLE_PREFIX_CANDIDATE_MULTIPLIER=8
STYLE_RETRIEVAL_THRESHOLD=0.30
STYLE_CHUNK_SIZE=900
STYLE_CHUNK_OVERLAP=120

# Multi-user session cache
MAX_CACHED_SESSIONS=1000

# Hugging Face token, only if private/gated models or higher rate limits are needed
HF_TOKEN=
