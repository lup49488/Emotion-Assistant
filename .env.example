# Core model selection
# Copy this file to .env for local use. Keep real API keys out of .env.example.
# Optional: .env.local can override .env on this machine and should not be committed.
LLM_PROVIDER=openai_compatible
CHAT_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# OpenAI-compatible API providers
# Do not commit real API keys.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_MODEL=deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Generation defaults
LLM_TEMPERATURE=0.8
LLM_TOP_P=0.9
LLM_MAX_NEW_TOKENS=300

# API reliability and local cost guardrails. 0 disables a limit.
# Costs are estimates only; set the rates from the pricing for the exact model you use.
API_REQUEST_TIMEOUT_SECONDS=60
API_MAX_RETRIES=2
API_RETRY_BACKOFF_SECONDS=1
API_MAX_REQUESTS_PER_MINUTE=0
API_DAILY_BUDGET_USD=0
API_MONTHLY_BUDGET_USD=0
API_INPUT_COST_PER_1M_TOKENS=0
API_OUTPUT_COST_PER_1M_TOKENS=0

# FastAPI signed-cookie session. Set API_SESSION_SECRET to a unique random value
# of at least 32 characters in .env.local or the server environment.
API_SESSION_SECRET=
API_SESSION_TTL_SECONDS=43200
API_SESSION_COOKIE_NAME=chatbot_session
API_CSRF_COOKIE_NAME=chatbot_csrf
# Set true when the API is served through HTTPS (for example via Cloudflare Tunnel).
API_COOKIE_SECURE=false
API_COOKIE_SAMESITE=lax
# Comma-separated browser frontend origins. Do not use * with Cookie authentication.
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Warm GoEmotions and the embedding model in a background thread when FastAPI starts.
# This never loads the local chat model.
API_PRELOAD_MODELS=true

# Local Hugging Face model performance
# LOCAL_MODEL_DTYPE supports auto, float16, bfloat16, float32.
LOCAL_MODEL_DTYPE=auto
# Example: flash_attention_2 or sdpa, if your installed torch/transformers supports it.
LOCAL_MODEL_ATTN_IMPLEMENTATION=
LOCAL_MODEL_LOW_CPU_MEM_USAGE=true
LOCAL_MODEL_COMPILE=false
# 0 means keep PyTorch default.
LOCAL_MODEL_CPU_THREADS=0
# Reject a likely out-of-memory load before Python exits unexpectedly.
LOCAL_MODEL_MEMORY_CHECK=true
LOCAL_MODEL_MEMORY_SAFETY_FACTOR=1.25
# Set only when the model name does not include its parameter count.
LOCAL_MODEL_PARAMETER_COUNT_B=0
# CPU/RAM offload is slower, but prevents a low-VRAM GPU from loading everything at once.
LOCAL_MODEL_ALLOW_CPU_OFFLOAD=false
LOCAL_MODEL_GPU_MAX_MEMORY_GB=5.5
LOCAL_MODEL_CPU_MAX_MEMORY_GB=12

# Gradio
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
GUI_PRELOAD_MODELS=true
# Keep Qwen on demand even when basic background warmup is enabled.
GUI_PRELOAD_LOCAL_LLM=false

# Storage backend. Keep json until you have run migrate_storage.py, then switch to sqlite.
STORAGE_BACKEND=json
# Optional absolute or relative SQLite database path. Empty uses data/chatbot.db.
SQLITE_DATABASE_PATH=

# Optional emergency password recovery. Leave blank in Git and set a unique random
# value of at least 20 characters only in the server environment or .env.local.
CHATBOT_ADMIN_RECOVERY_KEY=

# Knowledge base / RAG
KNOWLEDGE_ENABLED=false
KNOWLEDGE_TOP_K=4
KNOWLEDGE_RETRIEVAL_THRESHOLD=0.35
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=120
# Search a wider candidate pool before relevance and diversity filtering.
KNOWLEDGE_CANDIDATE_MULTIPLIER=4
# Prefer source diversity, then backfill when too few results remain.
KNOWLEDGE_MAX_PER_SOURCE=2
# Hard budget for knowledge text injected into one prompt.
KNOWLEDGE_MAX_CONTEXT_CHARS=4000
# Used by the quality report to flag fragments that are too short.
KNOWLEDGE_MIN_CHUNK_CHARS=40

# Style reference / Style RAG
STYLE_ENABLED=false
STYLE_TOP_K=3
STYLE_RETRIEVAL_THRESHOLD=0.30
STYLE_CHUNK_SIZE=900
STYLE_CHUNK_OVERLAP=120

# Multi-user session cache
MAX_CACHED_SESSIONS=1000

# Hugging Face token, only if private/gated models or higher rate limits are needed
HF_TOKEN=
